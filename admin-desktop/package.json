{
  "name": "pcclub-admin-desktop",
  "version": "1.0.0",
  "description": "PC Club Cashier & Club Administration Management Console",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite --port 5174",
    "build": "tsc && vite build && tsc -p tsconfig.electron.json",
    "preview": "vite preview --port 5174",
    "electron:dev": "tsc -p tsconfig.electron.json && concurrently \"vite --port 5174\" \"wait-on http://127.0.0.1:5174 && electron .\"",
    "dist": "npm run build && electron-builder --win",
    "dist:portable": "npm run build && electron-builder --win portable",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "kz.pcclub.admin",
    "productName": "PC Club Admin Console",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "config.json"
    ],
    "extraFiles": [
      {
        "from": "config.json",
        "to": "config.json"
      }
    ],
    "win": {
      "target": [
        "portable",
        "dir"
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "PCClub-Admin-Setup.exe"
    }
  }
}
