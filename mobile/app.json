{
  "expo": {
    "name": "Clutch",
    "slug": "pcclub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0A10",
        "foregroundImage": "./assets/clutch-logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Clutch uses the camera to scan the QR code on a club PC."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Clutch uses your location to show clubs near you."
        }
      ]
    ],
    "scheme": "pcclub",
    "experiments": {
      "typedRoutes": true
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A10"
    }
  }
}