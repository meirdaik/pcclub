{
  "name": "pcclub-desktop",
  "version": "1.0.0",
  "description": "PC Club kiosk application for gaming PCs",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc && vite build && tsc -p tsconfig.electron.json && node -e \"require('fs').copyFileSync('electron/keyBlocker.exe', 'dist-electron/keyBlocker.exe')\"",
    "preview": "vite preview --host 0.0.0.0",
    "electron:dev": "tsc -p tsconfig.electron.json && concurrently \"vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "dist": "npm run build && electron-builder --win",
    "dist:portable": "npm run build && electron-builder --win portable",
    "dist:dir": "npm run build && electron-builder --dir",
    "electron:build": "npm run dist"
  },
  "dependencies": {
    "framer-motion": "^14.13.0",
    "lucide-react": "^1.72.0",
    "qrcode.react": "^3.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "kz.pcclub.desktop",
    "productName": "PC Club Kiosk",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "config.json"
    ],
    "extraFiles": [
      {
        "from": "config.json",
        "to": "config.json"
      },
      {
        "from": "dist-electron/keyBlocker.exe",
        "to": "keyBlocker.exe"
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "PCClub-Gaming-Client.exe"
    }
  }
}
